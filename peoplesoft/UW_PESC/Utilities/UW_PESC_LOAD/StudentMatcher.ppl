/* ===========================================================================
 * UW_PESC:Utilities:UW_PESC_LOAD:StudentMatcher
 *
 * Finds the student's EMPLID with the delivered Search/Match component
 * interface HCR_SM_SEARCH. Works with whatever search parameter a school
 * has set up: the parameter's own search fields and rules drive it.
 *
 *    Local array of string &ids = &matcher.Match(&student.Person);
 *    &matcher.MatchStatus   MATCH (1 id) / MULTIPLE / NONE / ERROR
 *
 * Search parameter and result codes: crosswalk SM_PARM_CD / SM_RSLT_CD
 * keyed by INSTITUTION, otherwise Config.SearchParmCode /
 * SearchResultCode. Search type: Config.SearchType.
 *
 * How the CI works (from its generated template):
 *    keys              SM_TYPE, SM_PARM_CD, then Get()
 *    HCR_SM_SRCHFLDV   the parameter's search fields; the value goes in
 *                      SM_CHAR_INPUT or SM_DATE_INPUT on the row whose
 *                      FIELDNAME matches (SM_RULE says which rule a row
 *                      belongs to, when the CI fills it)
 *    HCR_SM_ORDR_TBL   one row per search rule, in the parameter's order;
 *                      SM_SLCT_SEARCH_BTN on a row runs that rule
 *    SM_SEARCH_BTN     the main Search button (used when there are no
 *                      rule rows)
 *    SM_RULE_CD        the rule that just ran
 *    HCR_SM_PER_VW     the people the last search found (EMPLID)
 *
 * Tiered rules: every rule is run. A rule that uses a search field the
 * transcript can't fill (no postal code, say) has its results ignored.
 * The decision comes from the strictest result: the usable rule(s) that
 * found the fewest people, but at least one. One person there = MATCH,
 * more = MULTIPLE, no usable rule found anyone = NONE. With rules
 * 10 First/Last, 20 First/Last/DOB, 30 First/Last/Postal and no postal
 * code, rule 20 decides whenever it finds someone, whatever rule 10 found.
 *
 * Buttons run their PeopleCode when set, so the CI runs in interactive
 * mode. It has no Save.
 *
 * Transcript values used, by search field name:
 *    FIRST_NAME, LAST_NAME, MIDDLE_NAME   Person/Name
 *    BIRTHDATE                            Person/Birth/BirthDate
 *    POSTAL                               first Person/Contacts PostalCode
 *                                         (5 characters)
 *    NATIONAL_ID                          Person/SSN (digits only)
 * Any other search field is left blank, and rules that use it are ignored.
 * ========================================================================= */
import UW_PESC:PersonType;
import UW_PESC:ContactsType;
import UW_PESC:AddressType;
import UW_PESC:Utilities:UW_PESC_LOAD:Config;
import UW_PESC:Utilities:UW_PESC_LOAD:Crosswalk;
import UW_PESC:Utilities:UW_PESC_LOAD:LoadResult;

class StudentMatcher
   method StudentMatcher(&settings As UW_PESC:Utilities:UW_PESC_LOAD:Config, &xwalk As UW_PESC:Utilities:UW_PESC_LOAD:Crosswalk, &log As UW_PESC:Utilities:UW_PESC_LOAD:LoadResult);
   method Match(&person As UW_PESC:PersonType) Returns array of string;

   property string MatchStatus;

private
   instance UW_PESC:Utilities:UW_PESC_LOAD:Config &cfg;
   instance UW_PESC:Utilities:UW_PESC_LOAD:Crosswalk &xw;
   instance UW_PESC:Utilities:UW_PESC_LOAD:LoadResult &res;

   /* transcript values, set at the start of Match */
   instance string &first;
   instance string &last;
   instance string &middle;
   instance string &postal;
   instance string &ssn;
   instance date &dob;

   method ReadPerson(&person As UW_PESC:PersonType);
   method FillSearchFields(&flds As ApiObject, &blocked As array of string) Returns integer;
   method Collect(&ci As ApiObject) Returns array of string;
   method SplitIds(&joined As string) Returns array of string;
   method PostalOf(&person As UW_PESC:PersonType) Returns string;
end-class;

method StudentMatcher
   /+ &settings as UW_PESC:Utilities:UW_PESC_LOAD:Config, +/
   /+ &xwalk as UW_PESC:Utilities:UW_PESC_LOAD:Crosswalk, +/
   /+ &log as UW_PESC:Utilities:UW_PESC_LOAD:LoadResult +/
   &cfg = &settings;
   &xw = &xwalk;
   &res = &log;
   %This.MatchStatus = "";
end-method;

method Match
   /+ &person as UW_PESC:PersonType +/
   /+ Returns Array of String +/
   Local array of string &ids = CreateArrayRept("", 0);
   Local array of string &found, &blocked;
   Local array of string &tried = CreateArrayRept("", 0);
   /* each usable rule's EMPLIDs, comma-joined */
   Local array of string &perRule = CreateArrayRept("", 0);
   Local ApiObject &ci, &ordr, &ordrRow;
   Local string &parmCd, &rsltCd, &rule, &f, &l;
   Local integer &i, &j, &filled, &fewest;

   %This.MatchStatus = "ERROR";

   If &person = Null Then
      &res.Err(0, "Search/Match: transcript has no Person.");
      Return &ids;
   End-If;
   %This.ReadPerson(&person);
   &f = &first;
   &l = &last;
   If None(&f) Or
         None(&l) Then
      &res.Err(0, "Search/Match: transcript has no first or last name; can't search.");
      Return &ids;
   End-If;

   /* ---- which parameter: per institution, else Config ---- */
   &parmCd = &xw.Lookup("SM_PARM_CD", &cfg.Institution);
   If None(&parmCd) Then
      &parmCd = &cfg.SearchParmCode;
   End-If;
   &rsltCd = &xw.Lookup("SM_RSLT_CD", &cfg.Institution);
   If None(&rsltCd) Then
      &rsltCd = &cfg.SearchResultCode;
   End-If;

   &ci = %Session.GetCompIntfc(CompIntfc.HCR_SM_SEARCH);
   If &ci = Null Then
      &res.AddPSMessages(0, "GetCompIntfc HCR_SM_SEARCH");
      &res.Err(0, "Search/Match: could not get component interface HCR_SM_SEARCH.");
      Return &ids;
   End-If;
   &ci.InteractiveMode = True;
   &ci.GetHistoryItems = True;
   &ci.EditHistoryItems = False;
   &ci.SM_TYPE = &cfg.SearchType;
   &ci.SM_PARM_CD = &parmCd;
   If Not &ci.Get() Then
      &res.AddPSMessages(0, "HCR_SM_SEARCH.Get");
      &res.Err(0, "Search/Match: Get failed for search type " | &cfg.SearchType | " / parameter " | &parmCd | ".");
      Return &ids;
   End-If;

   try
      If All(&rsltCd) Then
         &ci.SM_RSLT_CD = &rsltCd;
      End-If;

      &blocked = CreateArrayRept("", 0);
      &filled = %This.FillSearchFields(&ci.HCR_SM_SRCHFLDV, &blocked);
      If &filled = 0 Then
         &res.Err(0, "Search/Match: none of parameter " | &parmCd | "'s search fields could be filled from the transcript.");
         &ci.Cancel();
         Return &ids;
      End-If;

      /* ---- run each rule (or the one Search button) ---- */
      &ordr = &ci.HCR_SM_ORDR_TBL;
      If &ordr.Count = 0 Then
         &ci.SM_SEARCH_BTN = "Y";
         &found = %This.Collect(&ci);
         &perRule.Push(&found.Join(",", "", ""));
         &tried.Push("search: " | &found.Len);
      Else
         For &i = 1 To &ordr.Count
            &ordrRow = &ordr.Item(&i);
            &ordrRow.SM_SLCT_SEARCH_BTN = "Y";
            &rule = &ci.SM_RULE_CD;
            &found = %This.Collect(&ci);
            If All(&rule) And
                  &blocked.Find(&rule) > 0 Then
               &tried.Push("rule " | &rule | ": ignored, needs a field the transcript lacks");
            Else
               &perRule.Push(&found.Join(",", "", ""));
               &tried.Push("rule " | &rule | ": " | &found.Len);
            End-If;
         End-For;
      End-If;
   catch Exception &e
      &res.AddPSMessages(0, "HCR_SM_SEARCH");
      &res.Err(0, "Search/Match stopped: " | &e.ToString());
      &ci.Cancel();
      Return &ids;
   end-try;
   &res.AddPSMessages(0, "HCR_SM_SEARCH");
   &ci.Cancel();

   /* ---- strictest result: fewest people, at least one ---- */
   &fewest = 0;
   For &i = 1 To &perRule.Len
      &found = %This.SplitIds(&perRule [&i]);
      If &found.Len > 0 Then
         If &fewest = 0 Or
               &found.Len < &fewest Then
            &fewest = &found.Len;
         End-If;
      End-If;
   End-For;
   /* rules tied for fewest that found different people count together */
   For &i = 1 To &perRule.Len
      &found = %This.SplitIds(&perRule [&i]);
      If &found.Len = &fewest And
            &fewest > 0 Then
         For &j = 1 To &found.Len
            If &ids.Find(&found [&j]) = 0 Then
               &ids.Push(&found [&j]);
            End-If;
         End-For;
      End-If;
   End-For;

   Evaluate &ids.Len
   When 0
      %This.MatchStatus = "NONE";
      Break;
   When 1
      %This.MatchStatus = "MATCH";
      Break;
   When-Other
      %This.MatchStatus = "MULTIPLE";
   End-Evaluate;

   &res.Info(0, "Search/Match " | %This.MatchStatus | " with parameter " | &parmCd | " for " | &f | " " | &l | " (DOB " | &dob | ", postal " | &postal | "): " | &tried.Join("; ", "", "") | " -> [" | &ids.Join(", ", "", "") | "].");
   Return &ids;
end-method;

method ReadPerson
   /+ &person as UW_PESC:PersonType +/
   Local string &digits, &ch, &rawSsn;
   Local date &noDate;
   Local integer &i;

   &first = "";
   &last = "";
   &middle = "";
   &ssn = "";
   &dob = &noDate;
   If &person.Name <> Null Then
      &first = &person.Name.FirstName;
      &last = &person.Name.LastName;
      If &person.Name.MiddleName <> Null Then
         If &person.Name.MiddleName.Len > 0 Then
            &middle = &person.Name.MiddleName [1];
         End-If;
      End-If;
   End-If;
   If &person.Birth <> Null Then
      &dob = &person.Birth.BirthDate;
   End-If;
   &postal = %This.PostalOf(&person);

   /* SSN: digits only */
   &digits = "";
   &rawSsn = &person.SSN;
   For &i = 1 To Len(&rawSsn)
      &ch = Substring(&rawSsn, &i, 1);
      If &ch >= "0" And
            &ch <= "9" Then
         &digits = &digits | &ch;
      End-If;
   End-For;
   &ssn = &digits;
end-method;

method FillSearchFields
   /+ &flds as ApiObject, +/
   /+ &blocked as Array of String +/
   /+ Returns Integer +/
   /* Fills each search-field row it has a value for. Rules (SM_RULE) with a
      field it can't fill are added to &blocked. Returns rows filled. */
   Local ApiObject &fld;
   Local string &fieldName, &rule, &v;
   Local date &d;
   Local boolean &isDate, &have;
   Local integer &i;
   Local integer &filled = 0;

   For &i = 1 To &flds.Count
      &fld = &flds.Item(&i);
      &fieldName = Upper(&fld.FIELDNAME);
      &rule = &fld.SM_RULE;
      &v = "";
      &isDate = False;

      Evaluate &fieldName
      When "FIRST_NAME"
         &v = &first;
         Break;
      When "LAST_NAME"
         &v = &last;
         Break;
      When "MIDDLE_NAME"
         &v = &middle;
         Break;
      When "POSTAL"
         &v = &postal;
         Break;
      When "NATIONAL_ID"
         &v = &ssn;
         Break;
      When "BIRTHDATE"
         &isDate = True;
         Break;
      End-Evaluate;

      If &isDate Then
         &d = &dob;
         &have = All(&d);
         If &have Then
            &fld.SM_DATE_INPUT = &d;
         End-If;
      Else
         &have = All(&v);
         If &have Then
            &fld.SM_CHAR_INPUT = &v;
         End-If;
      End-If;

      If &have Then
         &filled = &filled + 1;
      Else
         If All(&fieldName) Then
            &res.Info(0, "Search/Match: no transcript value for search field " | &fieldName | "; rule(s) using it are ignored.");
         End-If;
         If All(&rule) Then
            If &blocked.Find(&rule) = 0 Then
               &blocked.Push(&rule);
            End-If;
         End-If;
      End-If;
   End-For;
   Return &filled;
end-method;

method Collect
   /+ &ci as ApiObject +/
   /+ Returns Array of String +/
   /* EMPLIDs the last search put in HCR_SM_PER_VW */
   Local array of string &ids = CreateArrayRept("", 0);
   Local ApiObject &hits;
   Local string &id;
   Local integer &i;

   &hits = &ci.HCR_SM_PER_VW;
   For &i = 1 To &hits.Count
      &id = &hits.Item(&i).EMPLID;
      If All(&id) Then
         If &ids.Find(&id) = 0 Then
            &ids.Push(&id);
         End-If;
      End-If;
   End-For;
   Return &ids;
end-method;

method SplitIds
   /+ &joined as String +/
   /+ Returns Array of String +/
   If None(&joined) Then
      Return CreateArrayRept("", 0);
   End-If;
   Return Split(&joined, ",");
end-method;

method PostalOf
   /+ &person as UW_PESC:PersonType +/
   /+ Returns String +/
   /* First PostalCode under Person/Contacts/Address, cut to 5 characters
      (US ZIP). */
   Local UW_PESC:ContactsType &contact;
   Local UW_PESC:AddressType &addr;
   Local string &zip;
   Local integer &i, &j;

   If &person.Contacts = Null Then
      Return "";
   End-If;
   For &i = 1 To &person.Contacts.Len
      &contact = &person.Contacts [&i];
      If &contact.Address <> Null Then
         For &j = 1 To &contact.Address.Len
            &addr = &contact.Address [&j];
            &zip = LTrim(RTrim(&addr.PostalCode));
            If All(&zip) Then
               Return Left(&zip, 5);
            End-If;
         End-For;
      End-If;
   End-For;
   Return "";
end-method;
