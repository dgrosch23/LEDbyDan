/* ===========================================================================
 * UW_CGER_XMLMERGE:SectionProvider
 *
 * Implement this to supply the extra data for one block of the XML file
 * (for a transcript, one <G_SSR_TSRSLT_HDR> = one student/report).
 *
 *    &key   - text of the block's key child element (e.g. EMPLID)
 *    &block - the original block element, if you need other values from it
 *             (use XmlNode.ChildNodes, or XmlFileMerger.ChildText)
 *
 * Return a Rowset shaped like your custom File Layout, or Null when there is
 * nothing to add for this block. Don't return an empty rowset: a rowset that
 * Fill() found nothing for still holds one blank row, and the layout would
 * write it as an empty section.
 * ========================================================================= */

interface SectionProvider
   method GetRowset(&key As string, &block As XmlNode) Returns Rowset;
end-interface;
