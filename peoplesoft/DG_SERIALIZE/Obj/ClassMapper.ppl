/* ===========================================================================
 * DG_SERIALIZE:Obj:ClassMapper
 *
 * Converts application class instances to and from DataNode trees.
 *
 * Class paths are matched case-insensitively. Every class that appears
 * anywhere in the tree (nested objects, object arrays) needs its own
 * registered schema unless it implements Serializable.
 *
 * Resolution for a class path:
 *    1. a ClassSchema registered for it  -> properties are read/written with
 *       ObjectGetProperty / ObjectSetProperty (works on classes you cannot
 *       modify, including delivered ones)
 *    2. otherwise the class must implement DG_SERIALIZE:Core:Serializable
 *       and its own ToNode/FromNode are called
 *
 *    Local DG_SERIALIZE:Obj:ClassMapper &m = create DG_SERIALIZE:Obj:ClassMapper();
 *    &m.Register(&employeeSchema);
 *    &m.Register(&addressSchema);
 *    Local DG_SERIALIZE:Core:DataNode &n = &m.ToNode(&emp, "MY_PKG:Model:Employee");
 *    Local MY_PKG:Model:Employee &copy = &m.FromNode(&n, "MY_PKG:Model:Employee");
 *
 * Deserialized arrays:
 *    - If the property already holds an array (typically created by the
 *      class constructor), that array is emptied and refilled, so typed
 *      properties such as "array of MY_PKG:Model:Address" work.
 *    - Otherwise a new array is assigned: a typed array for scalars
 *      (array of string / number / ...) or "array of any" for objects, so
 *      an object-array property must then be declared array of any.
 *    - A single value where the schema expects an array (common in XML,
 *      where one <Student> element is not distinguishable from an object)
 *      is loaded as a one-item array.
 * ========================================================================= */
import DG_SERIALIZE:Core:DataNode;
import DG_SERIALIZE:Core:Serializable;
import DG_SERIALIZE:Db:RecordMapper;
import DG_SERIALIZE:Obj:ClassSchema;
import DG_SERIALIZE:Obj:PropertyDescriptor;

class ClassMapper
   method ClassMapper();

   property DG_SERIALIZE:Db:RecordMapper Records;
   property boolean SkipNullObjects;

   method Register(&schema As DG_SERIALIZE:Obj:ClassSchema);
   method IsRegistered(&classPath As string) Returns boolean;

   method ToNode(&obj As object, &classPath As string) Returns DG_SERIALIZE:Core:DataNode;
   method FromNode(&node As DG_SERIALIZE:Core:DataNode, &classPath As string) Returns object;
   method Populate(&node As DG_SERIALIZE:Core:DataNode, &obj As object, &classPath As string);

private
   instance array of string &paths;
   instance array of any &schemas;

   method FindSchema(&classPath As string) Returns DG_SERIALIZE:Obj:ClassSchema;
   method MissingSchemaMessage(&classPath As string) Returns string;
   method PropertyToNode(&value As any, &p As DG_SERIALIZE:Obj:PropertyDescriptor) Returns DG_SERIALIZE:Core:DataNode;
   method NodeToPropertyValue(&node As DG_SERIALIZE:Core:DataNode, &p As DG_SERIALIZE:Obj:PropertyDescriptor) Returns any;
   method ScalarToNode(&value As any, &type As string) Returns DG_SERIALIZE:Core:DataNode;
   method NodeToScalar(&node As DG_SERIALIZE:Core:DataNode, &type As string) Returns any;
   method EmptyArrayFor(&type As string) Returns any;
   method AsArray(&node As DG_SERIALIZE:Core:DataNode) Returns DG_SERIALIZE:Core:DataNode;
   method RefillArray(&target As any, &node As DG_SERIALIZE:Core:DataNode, &p As DG_SERIALIZE:Obj:PropertyDescriptor);
   method AssignValue(&obj As object, &p As DG_SERIALIZE:Obj:PropertyDescriptor, &member As DG_SERIALIZE:Core:DataNode);
   method ReadProperty(&obj As object, &p As DG_SERIALIZE:Obj:PropertyDescriptor, &classPath As string) Returns any;
   method WriteProperty(&obj As object, &p As DG_SERIALIZE:Obj:PropertyDescriptor, &value As any);
   method Fail(&message As string);
end-class;


method ClassMapper
   &paths = CreateArrayRept("", 0);
   &schemas = CreateArrayAny();
   %This.Records = create DG_SERIALIZE:Db:RecordMapper();
   %This.SkipNullObjects = False;
end-method;


method Register
   /+ &schema as DG_SERIALIZE:Obj:ClassSchema +/
   Local number &idx = &paths.Find(Upper(&schema.ClassPath));
   If &idx > 0 Then
      &schemas [&idx] = &schema;
   Else
      &paths.Push(Upper(&schema.ClassPath));
      &schemas.Push(&schema);
   End-If;
end-method;


method IsRegistered
   /+ &classPath as String +/
   /+ Returns Boolean +/
   Return (&paths.Find(Upper(&classPath)) > 0);
end-method;


/* ------------------------------------------------------------------------ */
/* Object -> node                                                           */
/* ------------------------------------------------------------------------ */

method ToNode
   /+ &obj as Object, +/
   /+ &classPath as String +/
   /+ Returns DG_SERIALIZE:Core:DataNode +/
   Local DG_SERIALIZE:Obj:ClassSchema &schema;
   Local DG_SERIALIZE:Obj:PropertyDescriptor &p;
   Local DG_SERIALIZE:Core:Serializable &custom;
   Local DG_SERIALIZE:Core:DataNode &out;
   Local DG_SERIALIZE:Core:DataNode &member;
   Local any &value;
   Local number &i;

   If &obj = Null Then
      Return create DG_SERIALIZE:Core:DataNode("NULL");
   End-If;

   &schema = %This.FindSchema(&classPath);
   If &schema = Null Then
      try
         &custom = &obj;
      catch Exception &notCustom
         %This.Fail(%This.MissingSchemaMessage(&classPath));
      end-try;
      Return &custom.ToNode();
   End-If;

   &out = create DG_SERIALIZE:Core:DataNode("OBJECT");
   For &i = 1 To &schema.PropertyCount
      &p = &schema.PropertyAt(&i);
      &value = %This.ReadProperty(&obj, &p, &classPath);
      &member = %This.PropertyToNode(&value, &p);
      If Not (%This.SkipNullObjects And
            &member.IsNull()) Then
         &out.Put(&p.Key, &member);
      End-If;
   End-For;
   Return &out;
end-method;


method PropertyToNode
   /+ &value as Any, +/
   /+ &p as DG_SERIALIZE:Obj:PropertyDescriptor +/
   /+ Returns DG_SERIALIZE:Core:DataNode +/
   Local DG_SERIALIZE:Core:DataNode &arr;
   Local number &i;

   Evaluate &p.Kind
   When "SCALAR"
      Return %This.ScalarToNode(&value, &p.ScalarType);

   When "OBJECT"
      Return %This.ToNode(&value, &p.ClassPath);

   When "SCALAR_ARRAY"
      If &value = Null Then
         Return create DG_SERIALIZE:Core:DataNode("NULL");
      End-If;
      &arr = create DG_SERIALIZE:Core:DataNode("ARRAY");
      For &i = 1 To &value.Len
         &arr.Add(%This.ScalarToNode(&value [&i], &p.ScalarType));
      End-For;
      Return &arr;

   When "OBJECT_ARRAY"
      If &value = Null Then
         Return create DG_SERIALIZE:Core:DataNode("NULL");
      End-If;
      &arr = create DG_SERIALIZE:Core:DataNode("ARRAY");
      For &i = 1 To &value.Len
         &arr.Add(%This.ToNode(&value [&i], &p.ClassPath));
      End-For;
      Return &arr;

   When "RECORD"
      If &value = Null Then
         Return create DG_SERIALIZE:Core:DataNode("NULL");
      End-If;
      Return %This.Records.RecordToNode(&value);

   When "ROWSET"
      If &value = Null Then
         Return create DG_SERIALIZE:Core:DataNode("NULL");
      End-If;
      Return %This.Records.RowsetToNode(&value);
   End-Evaluate;

   %This.Fail("unknown property kind '" | &p.Kind | "' for " | &p.Name);
   Return Null;
end-method;


method ScalarToNode
   /+ &value as Any, +/
   /+ &type as String +/
   /+ Returns DG_SERIALIZE:Core:DataNode +/
   Local DG_SERIALIZE:Core:DataNode &n = create DG_SERIALIZE:Core:DataNode("NULL");

   Evaluate &type
   When "NUMBER"
      Return &n.SetNumber(&value);
   When "BOOLEAN"
      Return &n.SetBoolean(&value);
   When "DATE"
      If None(&value) Then
         Return &n;
      End-If;
      Return &n.SetDate(&value);
   When "DATETIME"
      If None(&value) Then
         Return &n;
      End-If;
      Return &n.SetDateTime(&value);
   When "TIME"
      If None(&value) Then
         Return &n;
      End-If;
      Return &n.SetTime(&value);
   End-Evaluate;

   Return &n.SetString(&value);
end-method;


/* ------------------------------------------------------------------------ */
/* Node -> object                                                           */
/* ------------------------------------------------------------------------ */

method FromNode
   /+ &node as DG_SERIALIZE:Core:DataNode, +/
   /+ &classPath as String +/
   /+ Returns Object +/
   Local object &obj;
   Local DG_SERIALIZE:Core:Serializable &custom;

   If &node = Null Then
      Return Null;
   End-If;
   If &node.IsNull() Then
      Return Null;
   End-If;

   &obj = CreateObject(&classPath);

   If %This.FindSchema(&classPath) = Null Then
      try
         &custom = &obj;
      catch Exception &notCustom
         %This.Fail(%This.MissingSchemaMessage(&classPath));
      end-try;
      &custom.FromNode(&node);
      Return &obj;
   End-If;

   %This.Populate(&node, &obj, &classPath);
   Return &obj;
end-method;


method Populate
   /+ &node as DG_SERIALIZE:Core:DataNode, +/
   /+ &obj as Object, +/
   /+ &classPath as String +/
   /* Fills an existing instance. Members missing from &node are left as
      they are, so defaults set by the constructor survive. */
   Local DG_SERIALIZE:Obj:ClassSchema &schema = %This.FindSchema(&classPath);
   Local DG_SERIALIZE:Obj:PropertyDescriptor &p;
   Local DG_SERIALIZE:Core:DataNode &member;
   Local any &existing;
   Local number &i;

   If &schema = Null Then
      %This.Fail("no ClassSchema registered for " | &classPath);
   End-If;
   If Not &node.IsObject() Then
      %This.Fail(&classPath | " can only be populated from an OBJECT node, got " | &node.Kind);
   End-If;

   For &i = 1 To &schema.PropertyCount
      &p = &schema.PropertyAt(&i);
      &member = &node.GetMember(&p.Key);
      If &member <> Null Then
         /* reuse an array the constructor already created (keeps its type) */
         &existing = Null;
         If &p.Kind = "SCALAR_ARRAY" Or
               &p.Kind = "OBJECT_ARRAY" Then
            If &member.IsNull() = False Then
               &existing = %This.ReadProperty(&obj, &p, &classPath);
            End-If;
         End-If;
         If &existing <> Null Then
            %This.RefillArray(&existing, &member, &p);
         Else
            %This.AssignValue(&obj, &p, &member);
         End-If;
      End-If;
   End-For;
end-method;


method NodeToPropertyValue
   /+ &node as DG_SERIALIZE:Core:DataNode, +/
   /+ &p as DG_SERIALIZE:Obj:PropertyDescriptor +/
   /+ Returns Any +/
   Local any &arr;
   Local array of any &objects;
   Local Record &rec;
   Local Rowset &rs;

   If &p.Kind = "SCALAR" Then
      Return %This.NodeToScalar(&node, &p.ScalarType);
   End-If;

   /* every structured kind maps null to Null */
   If &node.IsNull() Then
      Return Null;
   End-If;

   Evaluate &p.Kind
   When "OBJECT"
      Return %This.FromNode(&node, &p.ClassPath);

   When "SCALAR_ARRAY"
      &arr = %This.EmptyArrayFor(&p.ScalarType);
      %This.RefillArray(&arr, &node, &p);
      Return &arr;

   When "OBJECT_ARRAY"
      &objects = CreateArrayAny();
      %This.RefillArray(&objects, &node, &p);
      Return &objects;

   When "RECORD"
      &rec = CreateRecord(@("Record." | &p.RecordName));
      %This.Records.NodeToRecord(&node, &rec);
      Return &rec;

   When "ROWSET"
      /* flat rowsets only; for hierarchies populate a prepared rowset
         yourself with Records.NodeToRowset */
      &rs = CreateRowset(@("Record." | &p.RecordName));
      %This.Records.NodeToRowset(&node, &rs);
      Return &rs;
   End-Evaluate;

   %This.Fail("unknown property kind '" | &p.Kind | "' for " | &p.Name);
   Return Null;
end-method;


method NodeToScalar
   /+ &node as DG_SERIALIZE:Core:DataNode, +/
   /+ &type as String +/
   /+ Returns Any +/
   Evaluate &type
   When "NUMBER"
      Return &node.AsNumber();
   When "BOOLEAN"
      Return &node.AsBoolean();
   When "DATE"
      Return &node.AsDate();
   When "DATETIME"
      Return &node.AsDateTime();
   When "TIME"
      Return &node.AsTime();
   End-Evaluate;
   Return &node.AsString();
end-method;


method EmptyArrayFor
   /+ &type as String +/
   /+ Returns Any +/
   Local date &d;
   Local datetime &dt;
   Local time &t;

   Evaluate &type
   When "STRING"
      Return CreateArrayRept("", 0);
   When "NUMBER"
      Return CreateArrayRept(0, 0);
   When "BOOLEAN"
      Return CreateArrayRept( False, 0);
   When "DATE"
      Return CreateArrayRept(&d, 0);
   When "DATETIME"
      Return CreateArrayRept(&dt, 0);
   When "TIME"
      Return CreateArrayRept(&t, 0);
   End-Evaluate;
   Return CreateArrayAny();
end-method;


method AsArray
   /+ &node as DG_SERIALIZE:Core:DataNode +/
   /+ Returns DG_SERIALIZE:Core:DataNode +/
   /* a single value where an array is expected becomes a one-item array */
   Local DG_SERIALIZE:Core:DataNode &list;

   If &node.IsArray() Then
      Return &node;
   End-If;
   &list = create DG_SERIALIZE:Core:DataNode("ARRAY");
   &list.Add(&node);
   Return &list;
end-method;


method RefillArray
   /+ &target as Any, +/
   /+ &node as DG_SERIALIZE:Core:DataNode, +/
   /+ &p as DG_SERIALIZE:Obj:PropertyDescriptor +/
   /* empties &target, then pushes the converted items of &node into it */
   Local DG_SERIALIZE:Core:DataNode &items = %This.AsArray(&node);
   Local any &dropped;
   Local number &i;

   While &target.Len > 0
      &dropped = &target.Pop();
   End-While;

   For &i = 1 To &items.Count
      If &p.Kind = "SCALAR_ARRAY" Then
         &target.Push(%This.NodeToScalar(&items.ValueAt(&i), &p.ScalarType));
      Else
         &target.Push(%This.FromNode(&items.ValueAt(&i), &p.ClassPath));
      End-If;
   End-For;
end-method;


method MissingSchemaMessage
   /+ &classPath as String +/
   /+ Returns String +/
   Local string &known = "none";
   If &paths.Len > 0 Then
      &known = &paths.Join(", ", "", "");
   End-If;
   Return "no ClassSchema is registered for '" | &classPath | "' and it does not implement Serializable. Describe it with a ClassSchema and call Register(). Registered: " | &known;
end-method;


method ReadProperty
   /+ &obj as Object, +/
   /+ &p as DG_SERIALIZE:Obj:PropertyDescriptor, +/
   /+ &classPath as String +/
   /+ Returns Any +/
   /* ObjectGetProperty with an error that names the schema entry */
   Local any &value;
   try
      &value = ObjectGetProperty(&obj, &p.Name);
   catch Exception &noProperty
      %This.Fail("the schema for " | &classPath | " lists property '" | &p.Name | "', but the class has no public property by that name. The first argument of AddScalar/AddObject/... must be the PeopleCode property name; use WithKey() for a different JSON/XML name. (" | &noProperty.ToString() | ")");
   end-try;
   Return &value;
end-method;


method WriteProperty
   /+ &obj as Object, +/
   /+ &p as DG_SERIALIZE:Obj:PropertyDescriptor, +/
   /+ &value as Any +/
   /* ObjectSetProperty with an error that names the schema entry */
   try
      ObjectSetProperty(&obj, &p.Name, &value);
   catch Exception &cannotSet
      %This.Fail("cannot set property '" | &p.Name | "' (member '" | &p.Key | "'): check that the class has a public, settable property by that name and that its type matches the schema. (" | &cannotSet.ToString() | ")");
   end-try;
end-method;


method AssignValue
   /+ &obj as Object, +/
   /+ &p as DG_SERIALIZE:Obj:PropertyDescriptor, +/
   /+ &member as DG_SERIALIZE:Core:DataNode +/
   /* Sets one property. An object array is built as "array of any", which
      PeopleCode will not assign to a property typed "array of SomeClass";
      in that case retry with an array typed from a sample instance. */
   Local any &value = %This.NodeToPropertyValue(&member, &p);
   Local any &typed;
   Local object &sample;

   If &p.Kind <> "OBJECT_ARRAY" Then
      %This.WriteProperty(&obj, &p, &value);
      Return;
   End-If;
   If &value = Null Then
      %This.WriteProperty(&obj, &p, &value);
      Return;
   End-If;

   try
      ObjectSetProperty(&obj, &p.Name, &value);
   catch Exception &untyped
      try
         &sample = CreateObject(&p.ClassPath);
         &typed = CreateArrayRept(&sample, 0);
         %This.RefillArray(&typed, &member, &p);
         ObjectSetProperty(&obj, &p.Name, &typed);
      catch Exception &stillUntyped
         %This.Fail("cannot assign an array to property " | &p.Name | " (declared as a typed array of " | &p.ClassPath | "). Create the array in the class constructor, e.g. %This." | &p.Name | " = CreateArrayRept(create " | &p.ClassPath | "(), 0); or declare the property as array of any.");
      end-try;
   end-try;
end-method;


method FindSchema
   /+ &classPath as String +/
   /+ Returns DG_SERIALIZE:Obj:ClassSchema +/
   Local number &idx = &paths.Find(Upper(&classPath));
   If &idx = 0 Then
      Return Null;
   End-If;
   Return &schemas [&idx];
end-method;


method Fail
   /+ &message as String +/
   throw CreateException(0, 0, "DG_SERIALIZE:Obj:ClassMapper - " | &message);
end-method;
