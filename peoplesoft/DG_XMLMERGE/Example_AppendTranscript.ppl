/* ===========================================================================
 * Example: add custom sections to an existing BI Publisher transcript XML
 *
 * Put this after the delivered code has written and closed the transcript
 * file, and before the BI Publisher report is run against it (for example
 * an App Engine PeopleCode step that follows the delivered step).
 *
 * Replace the names marked <<< with yours:
 *    Z_TSCRPT_FL        your custom File Layout (Format = XML)
 *    Z_TSCRPT_HDR/DTL   the records in that layout, parent then child.
 *                       The rowset must have the same shape as the layout.
 *    STUDENT_TAG        the element in the delivered XML that holds one
 *                       student's transcript and contains an EMPLID child
 * ========================================================================= */
import DG_XMLMERGE:XmlFileMerger;

Local DG_XMLMERGE:XmlFileMerger &merge = create DG_XMLMERGE:XmlFileMerger();
Local string &path;
Local XmlDoc &doc;
Local array of XmlNode &students;
Local XmlNode &student;
Local string &emplid;
Local Rowset &rs;
Local Rowset &child;
Local number &rows;
Local number &i;
Local number &r;

/* 1. your existing code that finds the file */
&path = "/psoft/output/transcripts/TSCRPT_12345.xml";   /* <<< your path logic */

/* 2. read and parse it */
&merge.KeepBackup = True;   /* writes <path>.bak; turn off once you trust it */
&doc = &merge.Load(&path);

/* 3. one section per student in the file */
&students = &doc.GetElementsByTagName("STUDENT_TAG");   /* <<< */

For &i = 1 To &students.Len
   &student = &students [&i];
   &emplid = &merge.ChildText(&student, "EMPLID");

   /* 3a. load the extra data. Use your SQL here: Fill takes the WHERE
          clause, or populate the rowset from a CreateSQL fetch loop. */
   &rs = CreateRowset(Record.Z_TSCRPT_HDR, CreateRowset(Record.Z_TSCRPT_DTL));   /* <<< */
   &rows = &rs.Fill("WHERE EMPLID = :1", &emplid);
   If &rows > 0 Then
      For &r = 1 To &rs.ActiveRowCount
         &child = &rs(&r).GetRowset(Scroll.Z_TSCRPT_DTL);   /* <<< */
         &child.Fill("WHERE EMPLID = :1 AND SEQNUM = :2", &emplid, &rs(&r).Z_TSCRPT_HDR.SEQNUM.Value);   /* <<< */
      End-For;

      /* 3b. render with the custom layout and append under this student */
      &rows = &merge.AppendRowset(&student, &rs, "Z_TSCRPT_FL");   /* <<< */
   End-If;
End-For;

/* For a file with no per-student element, append once at the root:
      &rows = &merge.AppendRowset(&doc.DocumentElement, &rs, "Z_TSCRPT_FL");
*/

/* 4. save over the original: same location, same file name */
&merge.Save(&doc, &path);
